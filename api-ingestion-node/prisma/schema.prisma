datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model TelemetryLog {
  id        Int      @id @default(autoincrement())
  driverId  String   @map("driver_id")
  latitude  Float
  longitude Float
  status    String   @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("telemetry_logs")
}
